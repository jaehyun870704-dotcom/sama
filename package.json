{
  "name": "sama",
  "private": true,
  "version": "0.1.0",
  "description": "사마의전 — 조조전 모델 기반 턴제 전술 SRPG",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build -w @sama/core",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --force",
    "validate:stages": "node --experimental-strip-types tools/validate-stages.ts",
    "sim": "node --experimental-strip-types tools/sim.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": { "node": ">=22" }
}
